{
  "$comment": "Plan v3.1 phase 6.2(c) \u2014 a bound INSTANCE of a shot with parameters. The renderer's materializeInstance (shot-instance.ts) writes the values into the template; the kit's ShotBinding.TryApply binds the same template at run time. Every 'expected' here must equal BOTH: the renderer spec compares the whole shot, the kit's ShotBindingTests compares each bound text. Every template lints clean (shots-lint): a shot's COMMANDS are fixed (a placeholder in a setup or cheat is refused before it is sent), so in a real file the values land in click and hold NAMES. 'error' cases are the renderer's refusals (the kit is never sent such a shot).",
  "cases": [
    {
      "name": "a click name and a hold name are bound; a fixed cheat, the settle, an until and a vision prompt are left as written",
      "template": {
        "name": "hero-intro",
        "parameters": [
          "hero"
        ],
        "setup": [
          "skip-tutorial"
        ],
        "steps": [
          {
            "kind": "click",
            "name": "Hero_{hero}",
            "until": {
              "kind": "present",
              "name": "Card_{hero}"
            }
          },
          {
            "kind": "cheatUntil",
            "command": "open-roster",
            "until": {
              "kind": "present",
              "name": "Board"
            }
          },
          {
            "kind": "hold",
            "name": "Card_{hero}",
            "seconds": 1
          },
          {
            "kind": "vision",
            "prompt": "is {hero} on screen?"
          },
          {
            "kind": "wait",
            "seconds": 1
          }
        ],
        "settle": {
          "kind": "present",
          "name": "Card_{hero}"
        }
      },
      "values": [
        {
          "name": "hero",
          "value": "draco"
        }
      ],
      "expected": {
        "name": "hero-intro.draco",
        "setup": [
          "skip-tutorial"
        ],
        "steps": [
          {
            "kind": "click",
            "name": "Hero_draco",
            "until": {
              "kind": "present",
              "name": "Card_{hero}"
            }
          },
          {
            "kind": "cheatUntil",
            "command": "open-roster",
            "until": {
              "kind": "present",
              "name": "Board"
            }
          },
          {
            "kind": "hold",
            "name": "Card_draco",
            "seconds": 1
          },
          {
            "kind": "vision",
            "prompt": "is {hero} on screen?"
          },
          {
            "kind": "wait",
            "seconds": 1
          }
        ],
        "settle": {
          "kind": "present",
          "name": "Card_{hero}"
        },
        "instanceOf": "hero-intro",
        "values": [
          {
            "name": "hero",
            "value": "draco"
          }
        ]
      }
    },
